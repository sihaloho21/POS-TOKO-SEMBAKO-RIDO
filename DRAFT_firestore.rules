rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'OWNER';
    }

    function isKasir() {
      return isSignedIn() && getUserData().role == 'KASIR';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidId(userId);
      allow update: if isOwner() && (
        incoming().role == existing().role || isOwner() // Owner can change roles, but common check
      );
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner() && isValidId(productId);
    }

    // --- PRODUCT COSTS (OWNER ONLY) ---
    match /productCosts/{productId} {
      allow read, write: if isOwner() && isValidId(productId);
    }

    // --- BUNDLES ---
    match /bundles/{bundleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner() && isValidId(bundleId);
    }

    // --- CUSTOMERS ---
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(customerId);
      allow update: if isSignedIn();
    }

    // --- TRANSACTIONS (Append-Only Logic) ---
    match /transactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(txId) && (
        incoming().status == 'COMPLETED' || incoming().status == 'HOLD'
      );
      // No updates to completed transactions except status for VOID/RETURN
      allow update: if isSignedIn() && (
        (existing().status == 'HOLD' && incoming().status == 'COMPLETED') ||
        (existing().status == 'COMPLETED' && (incoming().status == 'VOIDED' || incoming().status == 'RETURNED'))
      ) && incoming().total == existing().total; // Cannot change total
    }

    // --- LEDGERS (Append-Only) ---
    match /financeEvents/{eventId} {
      allow read: if isOwner();
      allow create: if isSignedIn() && isValidId(eventId);
    }

    match /stockMovements/{movementId} {
      allow read: if isOwner();
      allow create: if isSignedIn() && isValidId(movementId);
    }

    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn() && isValidId(logId);
    }

    // --- SHIFTS ---
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(shiftId);
      allow update: if isSignedIn() && (
        existing().status == 'OPEN' && incoming().status == 'CLOSED'
      );
    }

    // --- SYNC QUEUE ---
    match /syncQueue/{queueId} {
      allow read, write: if isSignedIn();
    }

    // --- OTHER COLLECTIONS ---
    match /receivables/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
    
    match /purchases/{id} {
      allow read: if isSignedIn();
      allow create, update: if isOwner();
    }

    match /digitalServices/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /loyaltyEvents/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
