rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // In this app, we assume local user management via users collection
      // but we still want a signed in session.
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'OWNER';
    }

    function isKasir() {
      return isSignedIn() && (getUserData().role == 'KASIR' || getUserData().role == 'OWNER');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'role', 'pinHash', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'name', 'role', 'pinHash', 'status', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.role in ['OWNER', 'KASIR'] &&
             data.status in ['ACTIVE', 'INACTIVE'] &&
             data.pinHash is string && data.pinHash.size() == 6 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['productId', 'name', 'price', 'hpp', 'stock', 'status', 'updatedAt']) &&
             data.productId is string && data.productId.size() <= 64 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.hpp is number && data.hpp >= 0 &&
             data.stock is number &&
             data.status in ['ACTIVE', 'INACTIVE'] &&
             data.updatedAt == request.time;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['transactionId', 'receiptNumber', 'type', 'status', 'items', 'total', 'clientTimestamp', 'cashierId']) &&
             data.transactionId is string &&
             data.cashierId == request.auth.uid &&
             data.type in ['SALE', 'GAJIAN', 'RETURN', 'VOID'] &&
             data.status in ['COMPLETED', 'PENDING', 'VOIDED'] &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.clientTimestamp is string;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'pinHash', 'updatedAt']) && incoming().updatedAt == request.time) ||
        (isOwner() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'updatedAt']) && incoming().updatedAt == request.time)
      );
    }

    match /products/{productId} {
      allow read: if isKasir();
      // Only owner can create or update products
      allow create: if isOwner() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isOwner() && isValidId(productId) && isValidProduct(incoming());
    }

    match /transactions/{transactionId} {
      allow read: if isKasir();
      allow create: if isKasir() && isValidId(transactionId) && isValidTransaction(incoming());
      // Transactions are mostly immutable once COMPLETED
      allow update: if isOwner() && existing().status != 'VOIDED' && incoming().status == 'VOIDED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    match /financeEvents/{eventId} {
      allow read: if isOwner();
      allow create: if isKasir() && isValidId(eventId) && 
                      incoming().keys().hasAll(['financeEventId', 'amount', 'storageId', 'direction', 'timestamp']) &&
                      incoming().financeEventId == eventId &&
                      incoming().direction in ['IN', 'OUT'] &&
                      incoming().storageId in ['WARUNG', 'IKAN', 'UANG_DIGITAL'];
    }

    match /stockMovements/{movementId} {
      allow read: if isKasir();
      allow create: if isKasir() && isValidId(movementId) &&
                      incoming().keys().hasAll(['stockMovementId', 'productId', 'quantity', 'type', 'timestamp']) &&
                      incoming().stockMovementId == movementId &&
                      exists(/databases/$(database)/documents/products/$(incoming().productId));
    }
  }
}
