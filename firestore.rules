rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toko Sembako Riama - Multi-device Realtime Cloud Rules
    // Global allow for store operations
    match /{document=**} {
      allow read, write: if true;
    }

    match /users/{userId} { allow read, write: if true; }
    match /products/{productId} { allow read, write: if true; }
    match /productCosts/{productId} { allow read, write: if true; }
    match /customers/{customerId} { allow read, write: if true; }
    match /transactions/{transactionId} { allow read, write: if true; }
    match /TRANSACTION/{id} { allow read, write: if true; }
    match /TRANSACTIONS/{id} { allow read, write: if true; }
    match /transaction/{id} { allow read, write: if true; }
    match /financeEvents/{eventId} { allow read, write: if true; }
    match /stockMovements/{movementId} { allow read, write: if true; }
    match /auditLogs/{auditId} { allow read, write: if true; }
    match /bundles/{id} { allow read, write: if true; }
    match /suppliers/{id} { allow read, write: if true; }
    match /receivables/{id} { allow read, write: if true; }
    match /receivablePayments/{id} { allow read, write: if true; }
    match /purchases/{id} { allow read, write: if true; }
    match /payLaterBills/{id} { allow read, write: if true; }
    match /payLaterInstallments/{id} { allow read, write: if true; }
    match /conflicts/{id} { allow read, write: if true; }
    match /notifications/{id} { allow read, write: if true; }
    match /shifts/{id} { allow read, write: if true; }
    match /stockOpnames/{id} { allow read, write: if true; }
    match /digitalServices/{id} { allow read, write: if true; }
    match /loyaltyEvents/{id} { allow read, write: if true; }
    match /payrolls/{id} { allow read, write: if true; }
    match /bonusCategories/{id} { allow read, write: if true; }
    match /prepOrders/{id} { allow read, write: if true; }
    match /consignmentItems/{id} { allow read, write: if true; }
    match /consignmentArrivals/{id} { allow read, write: if true; }
    match /consignmentSettlements/{id} { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
  }
}
