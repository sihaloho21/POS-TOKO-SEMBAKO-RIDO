rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null; // Relaxed for dev, should check email_verified in prod
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isOwner() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'OWNER';
    }

    function isManager() {
      return isSignedIn() && (getUserData(request.auth.uid).role == 'MANAGER' || getUserData(request.auth.uid).role == 'OWNER');
    }

    function isKasir() {
      return isSignedIn() && (getUserData(request.auth.uid).role == 'KASIR' || isManager());
    }

    function isWarehouse() {
      return isSignedIn() && (getUserData(request.auth.uid).role == 'WAREHOUSE' || isManager());
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.role in ['OWNER', 'KASIR'] &&
             data.status in ['ACTIVE', 'INACTIVE'];
    }

    function isValidProduct(data) {
      return data.productId is string && data.productId.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.normalPrice is number &&
             (data.priceAlertThreshold == null || data.priceAlertThreshold is number) &&
             data.status in ['ACTIVE', 'INACTIVE'];
    }

    function isValidTransaction(data) {
      return data.transactionId is string && data.transactionId.size() <= 128 &&
             data.receiptNumber is string && data.receiptNumber.size() <= 64 &&
             data.type in ['SALE', 'GAJIAN', 'RETURN', 'VOID', 'DIGITAL_SERVICE'] &&
             data.status in ['COMPLETED', 'PENDING', 'VOIDED', 'CANCELLED', 'HOLD'] &&
             data.total is number &&
             data.cashierId == request.auth.uid;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isOwner();
      allow create: if isSignedIn() && (isOwner() || request.auth.uid == userId) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner() || request.auth.uid == userId);
    }

    match /products/{productId} {
      allow read: if isKasir() || isWarehouse();
      allow create: if isManager() || isWarehouse();
      allow update: if isManager() || isWarehouse();
    }

    match /customers/{customerId} {
      allow read: if isKasir();
      allow create: if isKasir() && isValidId(customerId);
      allow update: if isKasir() && isValidId(customerId);
    }

    match /transactions/{transactionId} {
      allow get: if isKasir();
      allow list: if isKasir();
      allow create: if isKasir() && isValidTransaction(incoming()) && incoming().transactionId == transactionId;
      allow update: if isManager() && isValidTransaction(incoming());
    }

    match /financeEvents/{eventId} {
      allow read: if isManager();
      allow create: if isKasir() && isValidId(eventId);
    }

    match /stockMovements/{movementId} {
      allow read: if isManager() || isWarehouse();
      allow create: if isKasir() || isWarehouse();
    }

    match /auditLogs/{auditId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
    }

    // Fallback for other collections mentioned in blueprint
    match /bundles/{id} { allow read, write: if isWarehouse(); }
    match /suppliers/{id} { allow read, write: if isWarehouse(); }
    match /receivables/{id} { allow read: if isKasir(); allow write: if isManager(); }
    match /purchases/{id} { allow read, write: if isWarehouse(); }
    match /conflicts/{id} { allow read, write: if isManager(); }
    match /notifications/{id} { allow read, write: if isKasir(); }
    match /shifts/{id} { allow read, write: if isKasir(); }
    match /stockOpnames/{id} { allow read, write: if isWarehouse() || isKasir(); }
    match /digitalServices/{id} { allow read: if isKasir(); allow write: if isManager(); }
    match /loyaltyEvents/{id} { allow read, write: if isManager(); }
  }
}
