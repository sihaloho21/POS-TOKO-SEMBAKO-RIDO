rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null; // Relaxed for dev, should check email_verified in prod
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.uid == 'pmSaKqfRHRXwJqiV7DWRQvpIIhz2' ||
        request.auth.token.email == 'ridohaloho1@gmail.com' ||
        (userDocExists(request.auth.uid) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER')
      );
    }

    function isManager() {
      return isOwner() || (
        isSignedIn() && userDocExists(request.auth.uid) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MANAGER', 'OWNER']
      );
    }

    function isKasir() {
      return isOwner() || isManager() || (
        isSignedIn() && (
          !userDocExists(request.auth.uid) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['KASIR', 'MANAGER', 'OWNER']
        )
      );
    }

    function isWarehouse() {
      return isOwner() || isManager() || (
        isSignedIn() && (
          !userDocExists(request.auth.uid) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['WAREHOUSE', 'MANAGER', 'OWNER']
        )
      );
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.role in ['OWNER', 'KASIR'] &&
             data.status in ['ACTIVE', 'INACTIVE'];
    }

    function isValidProduct(data) {
      return data.productId is string && data.productId.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.normalPrice is number &&
             (data.priceAlertThreshold == null || data.priceAlertThreshold is number) &&
             data.status in ['ACTIVE', 'INACTIVE'];
    }

    function isValidTransaction(data) {
      return data.transactionId is string && data.transactionId.size() <= 128 &&
             data.receiptNumber is string && data.receiptNumber.size() <= 64 &&
             data.type in ['SALE', 'GAJIAN', 'RETURN', 'VOID', 'DIGITAL_SERVICE'] &&
             data.status in ['COMPLETED', 'PENDING', 'VOIDED', 'CANCELLED', 'HOLD', 'approval_pending'] &&
             data.total is number &&
             data.cashierId is string && data.cashierId.size() <= 128;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isOwner();
      allow create: if isSignedIn() && (isOwner() || request.auth.uid == userId) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner() || request.auth.uid == userId);
    }

    match /products/{productId} {
      allow read: if isKasir() || isWarehouse() || isOwner();
      allow create, update: if isKasir() || isManager() || isWarehouse() || isOwner();
      allow delete: if isKasir() || isManager() || isWarehouse() || isOwner();
    }

    match /productCosts/{productId} {
      allow read, write: if isOwner();
    }

    match /customers/{customerId} {
      allow read: if isKasir() || isOwner();
      allow create, update: if isKasir() && isValidId(customerId);
      allow delete: if isKasir() || isOwner();
    }

    match /transactions/{transactionId} {
      allow get: if isKasir();
      allow list: if isKasir();
      allow create: if isKasir() && isValidTransaction(incoming()) && incoming().transactionId == transactionId;
      allow update: if isValidTransaction(incoming()) && (
        isManager() ||
        (isKasir() && incoming().status == 'approval_pending')
      );
    }

    match /financeEvents/{eventId} {
      allow read: if isManager();
      allow create: if isKasir() && isValidId(eventId);
    }

    match /stockMovements/{movementId} {
      allow read: if isManager() || isWarehouse();
      allow create: if isKasir() || isWarehouse();
    }

    match /auditLogs/{auditId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
    }

    // Fallback for other collections mentioned in blueprint
    match /bundles/{id} { allow read: if isKasir() || isWarehouse(); allow write: if isWarehouse(); }
    match /suppliers/{id} { allow read: if isKasir() || isWarehouse(); allow write: if isWarehouse(); }
    match /receivables/{id} { allow read: if isKasir(); allow write: if isKasir(); }
    match /receivablePayments/{id} { allow read: if isKasir(); allow write: if isKasir(); }
    match /purchases/{id} { allow read, write: if isWarehouse(); }
    match /payLaterBills/{id} { allow read, write: if isWarehouse() || isKasir(); }
    match /payLaterInstallments/{id} { allow read, write: if isWarehouse() || isKasir(); }
    match /conflicts/{id} { allow read, write: if isManager() || isKasir(); }
    match /notifications/{id} { allow read, write: if isKasir(); }
    match /shifts/{id} { allow read, write: if isKasir(); }
    match /stockOpnames/{id} { allow read, write: if isWarehouse() || isKasir(); }
    match /digitalServices/{id} { allow read: if isKasir(); allow write: if isKasir(); }
    match /loyaltyEvents/{id} { allow read: if isKasir(); allow write: if isKasir(); }
    match /payrolls/{id} { allow read, write: if isOwner(); }
    match /bonusCategories/{id} { allow read: if isSignedIn(); allow write: if isOwner(); }
    match /prepOrders/{id} { allow read, write: if isKasir() || isWarehouse() || isManager() || isOwner(); }
    match /consignmentItems/{id} { allow read, write: if isOwner() || isManager() || isWarehouse() || isKasir(); }
    match /consignmentArrivals/{id} { allow read, write: if isOwner() || isManager() || isWarehouse() || isKasir(); }
    match /consignmentSettlements/{id} { allow read, write: if isOwner() || isManager() || isWarehouse() || isKasir(); }
  }
}
