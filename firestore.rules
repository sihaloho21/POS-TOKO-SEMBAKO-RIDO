rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isSignedIn() && getUserData().role == 'OWNER';
    }

    function isKasir() {
      return isSignedIn() && (getUserData().role == 'KASIR' || getUserData().role == 'OWNER');
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if true;
      allow list: if isOwner();
      allow create, update: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /bundles/{bundleId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /suppliers/{supplierId} {
      allow read: if isOwner();
      allow create, update: if true;
    }

    match /transactions/{transactionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true; 
      allow update: if isOwner();
    }

    match /receivables/{receivableId} {
      allow read: if true;
      allow create: if true;
      allow update: if isOwner();
    }

    match /purchases/{purchaseId} {
      allow read: if isOwner();
      allow create, update: if isOwner();
    }

    match /financeEvents/{eventId} {
      allow read: if isOwner();
      allow create: if true;
    }

    match /stockMovements/{movementId} {
      allow read: if isOwner();
      allow create: if true;
    }

    match /auditLogs/{auditId} {
      allow read: if isOwner();
      allow create: if true;
    }

    match /conflicts/{conflictId} {
      allow read, update: if isOwner();
      allow create: if true;
    }

    match /notifications/{notifId} {
      allow read, update: if true;
      allow create: if true;
    }

    match /shifts/{shiftId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /digitalServices/{serviceId} {
      allow read: if true;
      allow create: if true;
      allow update: if isOwner();
    }
  }
}
